% Digital Signal Processing (EC3109) - Experiment 8
% Manual Iterative Calculation Code

clc;
clear;
close all;

%% Steps 2 to 4: Time Index and Unit Impulse Generation
n = -5 : 1 : 10;                  % Step 2: Define discrete time index n = -5:1:10
idx_zero = find(n == 0);          % Step 3: Find index where n = 0
x = zeros(size(n));               % Initialize x(n) = 0
x(idx_zero) = 1;                  % Step 4: Unit impulse x(0) = 1, otherwise 0

%% Case 1: b1 = 2 (Manual Iteration)
b1_val1 = 2;
y1_case1 = zeros(size(n));        % Step 9: Initialise y1(n) = 0 for all n

% Step 10: Iterative computation
for k = 1:length(n)
    if n(k) < 0
        y1_case1(k) = 0;          % If n < 0, keep y1(n) = 0
    else
        % If n >= 0, compute using difference equation: y1(n) = 2*y1(n-1) + x(n)
        y1_case1(k) = b1_val1 * y1_case1(k - 1) + x(k);
    end
end

%% Case 2: b1 = 0.5 (Manual Iteration)
b1_val2 = 0.5;
y1_case2 = zeros(size(n));        % Step 9: Initialise y1(n) = 0 for all n

% Step 10: Iterative computation
for k = 1:length(n)
    if n(k) < 0
        y1_case2(k) = 0;          % If n < 0, keep y1(n) = 0
    else
        % If n >= 0, compute using difference equation: y1(n) = 0.5*y1(n-1) + x(n)
        y1_case2(k) = b1_val2 * y1_case2(k - 1) + x(k);
    end
end

%% Step 11: Plotting Outputs
figure('Name', 'Experiment 8 - Manual Iteration Method', 'NumberTitle', 'off');

% Subplot 1: Input Sequence x(n)
subplot(3, 1, 1);
stem(n, x, 'filled', 'LineWidth', 1.5);
title('Input Sequence: Unit Impulse x(n)');
xlabel('n'); ylabel('x(n)');
grid on;

% Subplot 2: Output for b1 = 2
subplot(3, 1, 2);
stem(n, y1_case1, 'r', 'filled', 'LineWidth', 1.5);
title('Output y_1(n) via Manual Iteration (b_1 = 2, Unstable)');
xlabel('n'); ylabel('y_1(n)');
grid on;

% Subplot 3: Output for b1 = 0.5
subplot(3, 1, 3);
stem(n, y1_case2, 'b', 'filled', 'LineWidth', 1.5);
title('Output y_1(n) via Manual Iteration (b_1 = 0.5, Stable)');
xlabel('n'); ylabel('y_1(n)');
grid on;
